{
  "name": "latex-review-live",
  "displayName": "LaTeX Review and Visual Editor",
  "description": "Track changes with accept/reject, review comments, and a visual editor that shows the document like the PDF and lets you edit it there.",
  "version": "0.4.2",
  "publisher": "paivel",
  "license": "Apache-2.0",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.97.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "latex",
    "track changes",
    "review",
    "comments",
    "wysiwyg",
    "visual editor"
  ],
  "main": "./dist/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onLanguage:latex",
    "onLanguage:tex",
    "onWebviewPanel:latexReview.visual"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In a folder you do not trust, citations are not fetched from Zotero by themselves, and PDF figures are drawn in the page instead of by Quick Look or pdftoppm.",
      "restrictedConfigurations": [
        "latexReview.zotero.server",
        "latexReview.zotero.autoBibliography"
      ]
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "latexReview.openVisualEditor",
        "title": "Open Visual Editor",
        "category": "LaTeX Review",
        "icon": "$(eye)"
      },
      {
        "command": "latexReview.formatSource",
        "title": "Bold, Italic or Underline in LaTeX",
        "category": "LaTeX Review"
      },
      {
        "command": "latexReview.visualFormat",
        "title": "Format Text in the Visual Editor",
        "category": "LaTeX Review"
      },
      {
        "command": "latexReview.updateBibliography",
        "title": "Update Bibliography from Zotero",
        "category": "LaTeX Review"
      },
      {
        "command": "latexReview.startTracking",
        "title": "Start Tracking Changes",
        "category": "LaTeX Review",
        "icon": "$(record)"
      },
      {
        "command": "latexReview.stopTracking",
        "title": "Stop Tracking Changes",
        "category": "LaTeX Review",
        "icon": "$(debug-stop)"
      },
      {
        "command": "latexReview.acceptChange",
        "title": "Accept Change",
        "category": "LaTeX Review",
        "icon": "$(check)"
      },
      {
        "command": "latexReview.rejectChange",
        "title": "Reject Change",
        "category": "LaTeX Review",
        "icon": "$(close)"
      },
      {
        "command": "latexReview.acceptAll",
        "title": "Accept All Changes",
        "category": "LaTeX Review",
        "icon": "$(check-all)"
      },
      {
        "command": "latexReview.rejectAll",
        "title": "Reject All Changes",
        "category": "LaTeX Review",
        "icon": "$(discard)"
      },
      {
        "command": "latexReview.nextChange",
        "title": "Next Change",
        "category": "LaTeX Review",
        "icon": "$(arrow-down)"
      },
      {
        "command": "latexReview.previousChange",
        "title": "Previous Change",
        "category": "LaTeX Review",
        "icon": "$(arrow-up)"
      },
      {
        "command": "latexReview.addComment",
        "title": "Add Comment",
        "category": "LaTeX Review",
        "icon": "$(comment)"
      },
      {
        "command": "latexReview.replyComment",
        "title": "Reply",
        "category": "LaTeX Review"
      },
      {
        "command": "latexReview.resolveThread",
        "title": "Resolve",
        "category": "LaTeX Review",
        "icon": "$(pass)"
      },
      {
        "command": "latexReview.reopenThread",
        "title": "Reopen",
        "category": "LaTeX Review",
        "icon": "$(issue-reopened)"
      },
      {
        "command": "latexReview.deleteThread",
        "title": "Delete Thread",
        "category": "LaTeX Review",
        "icon": "$(trash)"
      },
      {
        "command": "latexReview.deleteComment",
        "title": "Delete Comment",
        "category": "LaTeX Review",
        "icon": "$(trash)"
      },
      {
        "command": "latexReview.editComment",
        "title": "Edit Comment",
        "category": "LaTeX Review",
        "icon": "$(edit)"
      },
      {
        "command": "latexReview.saveComment",
        "title": "Save",
        "category": "LaTeX Review"
      },
      {
        "command": "latexReview.cancelEditComment",
        "title": "Cancel",
        "category": "LaTeX Review"
      },
      {
        "command": "latexReview.exportMarkedUp",
        "title": "Export Marked-Up Copy (changes package)",
        "category": "LaTeX Review"
      },
      {
        "command": "latexReview.revealChange",
        "title": "Go to Change",
        "category": "LaTeX Review"
      },
      {
        "command": "latexReview.visualUndo",
        "title": "Undo in the Visual Editor",
        "category": "LaTeX Review"
      }
    ],
    "keybindings": [
      {
        "command": "latexReview.nextChange",
        "key": "ctrl+alt+]",
        "mac": "cmd+alt+]",
        "when": "editorTextFocus && latexReview.tracking"
      },
      {
        "command": "latexReview.previousChange",
        "key": "ctrl+alt+[",
        "mac": "cmd+alt+[",
        "when": "editorTextFocus && latexReview.tracking"
      },
      {
        "command": "latexReview.addComment",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "editorTextFocus && editorLangId =~ /^(latex|tex)$/"
      },
      {
        "command": "latexReview.openVisualEditor",
        "key": "ctrl+alt+v",
        "mac": "cmd+alt+v",
        "when": "editorLangId =~ /^(latex|tex)$/"
      },
      {
        "command": "latexReview.visualFormat",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "args": "bold",
        "when": "activeWebviewPanelId =~ /latexReview\\.visual$/"
      },
      {
        "command": "latexReview.visualFormat",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "args": "italic",
        "when": "activeWebviewPanelId =~ /latexReview\\.visual$/"
      },
      {
        "command": "latexReview.visualFormat",
        "key": "ctrl+u",
        "mac": "cmd+u",
        "args": "underline",
        "when": "activeWebviewPanelId =~ /latexReview\\.visual$/"
      },
      {
        "command": "latexReview.formatSource",
        "key": "ctrl+b",
        "mac": "cmd+b",
        "args": "bold",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^(latex|tex)$/"
      },
      {
        "command": "latexReview.formatSource",
        "key": "ctrl+i",
        "mac": "cmd+i",
        "args": "italic",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^(latex|tex)$/"
      },
      {
        "command": "latexReview.formatSource",
        "key": "ctrl+u",
        "mac": "cmd+u",
        "args": "underline",
        "when": "editorTextFocus && !editorReadonly && editorLangId =~ /^(latex|tex)$/"
      },
      {
        "command": "latexReview.visualUndo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "args": false,
        "when": "activeWebviewPanelId =~ /latexReview\\.visual$/"
      },
      {
        "command": "latexReview.visualUndo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "args": true,
        "when": "activeWebviewPanelId =~ /latexReview\\.visual$/"
      },
      {
        "command": "latexReview.visualUndo",
        "key": "ctrl+y",
        "args": true,
        "when": "activeWebviewPanelId =~ /latexReview\\.visual$/"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "latexReviewPane",
          "title": "LaTeX Review",
          "icon": "$(git-pull-request)"
        }
      ]
    },
    "views": {
      "latexReviewPane": [
        {
          "id": "latexReview.pane",
          "name": "Review",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "editor/title": [
        {
          "command": "latexReview.openVisualEditor",
          "when": "editorLangId =~ /^(latex|tex)$/",
          "group": "navigation@51"
        }
      ],
      "editor/context": [
        {
          "command": "latexReview.acceptChange",
          "when": "latexReview.tracking",
          "group": "latexReview@1"
        },
        {
          "command": "latexReview.rejectChange",
          "when": "latexReview.tracking",
          "group": "latexReview@2"
        },
        {
          "command": "latexReview.addComment",
          "when": "editorLangId =~ /^(latex|tex)$/",
          "group": "latexReview@3"
        }
      ],
      "view/title": [
        {
          "command": "latexReview.startTracking",
          "when": "view == latexReview.pane && !latexReview.tracking",
          "group": "navigation@1"
        },
        {
          "command": "latexReview.acceptAll",
          "when": "view == latexReview.pane && latexReview.tracking",
          "group": "navigation@1"
        },
        {
          "command": "latexReview.rejectAll",
          "when": "view == latexReview.pane && latexReview.tracking",
          "group": "navigation@2"
        },
        {
          "command": "latexReview.stopTracking",
          "when": "view == latexReview.pane && latexReview.tracking",
          "group": "navigation@3"
        },
        {
          "command": "latexReview.exportMarkedUp",
          "when": "view == latexReview.pane && latexReview.tracking",
          "group": "more@1"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "latexReview.resolveThread",
          "when": "commentController == latexReview && commentThread == open",
          "group": "inline@1"
        },
        {
          "command": "latexReview.reopenThread",
          "when": "commentController == latexReview && commentThread == resolved",
          "group": "inline@1"
        },
        {
          "command": "latexReview.deleteThread",
          "when": "commentController == latexReview && !commentThreadIsEmpty",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "latexReview.replyComment",
          "when": "commentController == latexReview",
          "group": "inline"
        }
      ],
      "comments/comment/title": [
        {
          "command": "latexReview.editComment",
          "when": "commentController == latexReview && comment == mine",
          "group": "inline@1"
        },
        {
          "command": "latexReview.deleteComment",
          "when": "commentController == latexReview",
          "group": "inline@2"
        }
      ],
      "comments/comment/context": [
        {
          "command": "latexReview.cancelEditComment",
          "when": "commentController == latexReview",
          "group": "inline@1"
        },
        {
          "command": "latexReview.saveComment",
          "when": "commentController == latexReview",
          "group": "inline@2"
        }
      ],
      "commandPalette": [
        {
          "command": "latexReview.visualUndo",
          "when": "false"
        },
        {
          "command": "latexReview.formatSource",
          "when": "false"
        },
        {
          "command": "latexReview.visualFormat",
          "when": "false"
        },
        {
          "command": "latexReview.acceptChange",
          "when": "latexReview.tracking"
        },
        {
          "command": "latexReview.rejectChange",
          "when": "latexReview.tracking"
        },
        {
          "command": "latexReview.acceptAll",
          "when": "latexReview.tracking"
        },
        {
          "command": "latexReview.rejectAll",
          "when": "latexReview.tracking"
        },
        {
          "command": "latexReview.nextChange",
          "when": "latexReview.tracking"
        },
        {
          "command": "latexReview.previousChange",
          "when": "latexReview.tracking"
        },
        {
          "command": "latexReview.stopTracking",
          "when": "latexReview.tracking"
        },
        {
          "command": "latexReview.exportMarkedUp",
          "when": "latexReview.tracking"
        },
        {
          "command": "latexReview.replyComment",
          "when": "false"
        },
        {
          "command": "latexReview.resolveThread",
          "when": "false"
        },
        {
          "command": "latexReview.reopenThread",
          "when": "false"
        },
        {
          "command": "latexReview.deleteThread",
          "when": "false"
        },
        {
          "command": "latexReview.deleteComment",
          "when": "false"
        },
        {
          "command": "latexReview.editComment",
          "when": "false"
        },
        {
          "command": "latexReview.saveComment",
          "when": "false"
        },
        {
          "command": "latexReview.cancelEditComment",
          "when": "false"
        },
        {
          "command": "latexReview.revealChange",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "LaTeX Review and Visual Editor",
      "properties": {
        "latexReview.author": {
          "type": "string",
          "default": "",
          "description": "Your name on comments. Empty: git user.name, else your account name."
        },
        "latexReview.zotero.autoBibliography": {
          "type": "boolean",
          "default": true,
          "description": "When a \\cite key is missing from the document's .bib file (\\bibliography or \\addbibresource), fetch the entry from Zotero (Better BibTeX) and append it. Zotero must be running."
        },
        "latexReview.zotero.server": {
          "type": "string",
          "default": "http://127.0.0.1:23119",
          "description": "Address of Zotero's local server.",
          "scope": "machine"
        },
        "latexReview.visual.followCursor": {
          "type": "boolean",
          "default": true,
          "description": "Visual editor: scroll to the place of the cursor in the source, and scroll the source to the place you edit."
        }
      }
    },
    "colors": [
      {
        "id": "latexReview.insertedForeground",
        "description": "Text inserted while tracking changes.",
        "defaults": {
          "light": "#1a56c9",
          "dark": "#6ea8ff",
          "highContrast": "#6ea8ff"
        }
      },
      {
        "id": "latexReview.insertedBackground",
        "description": "Background of inserted text.",
        "defaults": {
          "light": "#1a56c91a",
          "dark": "#6ea8ff1f",
          "highContrast": "#00000000"
        }
      },
      {
        "id": "latexReview.deletedForeground",
        "description": "Deleted text, shown struck through.",
        "defaults": {
          "light": "#c62828",
          "dark": "#ff7b72",
          "highContrast": "#ff7b72"
        }
      },
      {
        "id": "latexReview.commentBackground",
        "description": "Background of text that has a comment.",
        "defaults": {
          "light": "#f5c51840",
          "dark": "#f5c51830",
          "highContrast": "#00000000"
        }
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p . && tsc -p tsconfig.web.json && vitest run",
    "package": "npm run check && node scripts/build.mjs --minify && vsce package --no-dependencies --allow-missing-repository"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "1.97.0",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "katex": "^0.19.1",
    "pdfjs-dist": "^6.5.438",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "diff": "^9.0.0"
  }
}
